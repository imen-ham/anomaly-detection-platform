{
  "annotations": [
    {
      "kind": "AnnotationQuery",
      "spec": {
        "builtIn": true,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "query": {
          "datasource": {
            "name": "-- Grafana --"
          },
          "group": "grafana",
          "kind": "DataQuery",
          "spec": {},
          "version": "v0"
        }
      }
    }
  ],
  "cursorSync": "Off",
  "editable": true,
  "elements": {
    "backend_availability": {
      "kind": "Panel",
      "spec": {
        "id": 1,
        "title": "Backend Availability (SLO: 99.5%)",
        "description": "Backend API uptime vs SLO target of 99.5%",
        "type": "timeseries",
        "dataSource": {
          "type": "prometheus",
          "uid": "prometheus_uid",
          "name": "Prometheus"
        },
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "expr": "sre:backend_availability:1h",
                "legendFormat": "Backend Availability (1h)",
                "refId": "A",
                "datasourceUid": "prometheus_uid"
              }
            ],
            "transformations": [],
            "queryOptions": {}
          },
          "group": "panel",
          "version": "v0"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineWidth": 1,
              "showPoints": "never"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 0.95
                },
                {
                  "color": "green",
                  "value": 0.995
                }
              ]
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "calcs": ["mean", "last"],
            "displayMode": "table",
            "placement": "bottom"
          }
        }
      }
    },
    "backend_error_rate": {
      "kind": "Panel",
      "spec": {
        "id": 2,
        "title": "Backend Error Rate",
        "description": "Error rate vs SLO target of <0.1%",
        "type": "timeseries",
        "dataSource": {
          "type": "prometheus",
          "uid": "prometheus_uid",
          "name": "Prometheus"
        },
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "expr": "sre:backend_error_rate:5m",
                "legendFormat": "Error Rate (SLO: <0.1%)",
                "refId": "A",
                "datasourceUid": "prometheus_uid"
              }
            ],
            "transformations": [],
            "queryOptions": {}
          },
          "group": "panel",
          "version": "v0"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineWidth": 1,
              "showPoints": "never"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 0.001
                },
                {
                  "color": "red",
                  "value": 0.005
                }
              ]
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "calcs": ["mean", "last"],
            "displayMode": "table",
            "placement": "bottom"
          }
        }
      }
    },
    "backend_latency": {
      "kind": "Panel",
      "spec": {
        "id": 3,
        "title": "Backend Latency (P95)",
        "description": "P95 latency vs SLO target of 500ms",
        "type": "timeseries",
        "dataSource": {
          "type": "prometheus",
          "uid": "prometheus_uid",
          "name": "Prometheus"
        },
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m])) by (le))",
                "legendFormat": "P95 Latency (SLO: 500ms)",
                "refId": "A",
                "datasourceUid": "prometheus_uid"
              }
            ],
            "transformations": [],
            "queryOptions": {}
          },
          "group": "panel",
          "version": "v0"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "lineWidth": 1,
              "showPoints": "never"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 0.5
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            },
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "calcs": ["mean", "last"],
            "displayMode": "table",
            "placement": "bottom"
          }
        }
      }
    },
    "error_budget": {
      "kind": "Panel",
      "spec": {
        "id": 4,
        "title": "Error Budget Remaining (Backend)",
        "description": "Days until error budget exhaustion",
        "type": "gauge",
        "dataSource": {
          "type": "prometheus",
          "uid": "prometheus_uid",
          "name": "Prometheus"
        },
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "expr": "sre:backend_days_until_budget_exhausted:30d",
                "legendFormat": "Days until budget exhausted",
                "refId": "A",
                "datasourceUid": "prometheus_uid"
              }
            ],
            "transformations": [],
            "queryOptions": {}
          },
          "group": "panel",
          "version": "v0"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 1
                },
                {
                  "color": "yellow",
                  "value": 3
                },
                {
                  "color": "green",
                  "value": 7
                }
              ]
            },
            "unit": "d"
          },
          "overrides": []
        },
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      }
    },
    "backend_status": {
      "kind": "Panel",
      "spec": {
        "id": 5,
        "title": "Backend Status",
        "description": "Backend service operational status",
